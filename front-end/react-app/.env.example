# The Nest backend's default port is 5500.
VITE_API_BASE_URL=http://127.0.0.1:5500

# Replace these sample values with the logged-in user's actual values.
# The backend requires all three headers for GET /notifications.
VITE_USER_ID=replace-with-user-id
VITE_USER_ROLE=team_member
VITE_COMPANY_ID=replace-with-company-id
