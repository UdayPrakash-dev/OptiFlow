# ==============================================================================
# OptiFlow Environment Configuration Template
# All variables marked [REQUIRED] must be set; the application refuses to boot if absent.
# ==============================================================================

# Server
NODE_ENV=development
PORT=5500
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optiflow_dev?schema=public

# Security & Secrets [REQUIRED - NO FALLBACK DEFAULTS IN PRODUCTION]
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_at_least_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_32_chars_long

# Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
# S3_BUCKET=optiflow-evidence
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Mail (console | resend | smtp)
MAIL_DRIVER=console
# RESEND_API_KEY=
# MAIL_FROM=noreply@optiflow.io

# Logging
LOG_LEVEL=debug
