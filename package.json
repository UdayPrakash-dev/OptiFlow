{
  "name": "optiflow-api",
  "version": "1.0.0",
  "description": "OptiFlow API - Modular multi-tenant organizational workflow and compliance backend",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#platform/*": "./src/platform/*",
    "#modules/*": "./src/modules/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed/seed.js"
  },
  "keywords": [
    "optiflow",
    "express5",
    "multi-tenant",
    "workflow",
    "compliance",
    "nodejs"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
