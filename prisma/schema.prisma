// OptiFlow Prisma Schema
// PostgreSQL database schema with strict multi-tenant isolation, composite unique constraints,
// real foreign keys, indexed queries, and complete domain models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. PLATFORM LAYER (Billing, Plans, Super-Admins & Support Access)
// ---------------------------------------------------------------------------

model Plan {
  id                        String   @id @default(uuid())
  name                      String   @unique
  maxBranches               Int?     // null = unlimited
  maxUsers                  Int?
  maxActiveProcessTemplates Int?
  maxComplianceRules        Int?
  maxStorageMb              Int?     @default(1000)
  auditLogRetentionDays     Int      @default(90)
  allowsIntegrations        Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  companyId          String             @unique
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle       @default(Monthly)
  status             SubscriptionStatus @default(Active)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([companyId])
  @@index([planId])
  @@map("subscriptions")
}

enum BillingCycle {
  Monthly
  Annual
}

enum SubscriptionStatus {
  Active
  PastDue
  Cancelled
  Trialing
}

model PlatformAdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supportGrants PlatformSupportAccess[]

  @@map("platform_admin_users")
}

model PlatformSupportAccess {
  id          String            @id @default(uuid())
  adminUserId String
  adminUser   PlatformAdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason      String
  grantedAt   DateTime          @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  actionLog   Json              @default("[]")

  @@index([adminUserId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("platform_support_accesses")
}

// ---------------------------------------------------------------------------
// 2. TENANCY LAYER (Company & Multi-Tenant Root)
// ---------------------------------------------------------------------------

model Company {
  id        String        @id @default(uuid())
  legalName String        @unique
  status    CompanyStatus @default(Active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Platform Relations
  subscription    Subscription?
  supportAccesses PlatformSupportAccess[]

  // Tenancy & Org Relations
  users                User[]
  roles                Role[]
  branches             Branch[]
  teams                Team[]
  teamMembers          TeamMember[]
  roleAssignments      RoleAssignment[]
  projects             Project[]
  tasks                Task[]
  subtasks             Subtask[]
  escalations          Escalation[]
  processTemplates     ProcessTemplate[]
  processTemplateSteps ProcessTemplateStep[]
  processInstances     ProcessInstance[]
  processInstanceSteps ProcessInstanceStep[]
  complianceCategories ComplianceCategory[]
  complianceRules      ComplianceRule[]
  complianceBindings   ComplianceBinding[]
  complianceViolations ComplianceViolation[]
  complianceEvidence   ComplianceEvidence[]
  fileObjects          FileObject[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("companies")
}

enum CompanyStatus {
  Active
  Suspended
  Closed
}

// ---------------------------------------------------------------------------
// 3. IDENTITY & ACCESS (Users, Tokens, Permissions, Roles & Scoped Grants)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  fullName      String
  roleTitle     String?
  managerUserId String?
  manager       User?     @relation("ManagerReports", fields: [managerUserId], references: [id])
  reports       User[]    @relation("ManagerReports")
  tokenVersion  Int       @default(1)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Identity relations
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  roleAssignments     RoleAssignment[]     @relation("AssignmentUser")
  grantedAssignments  RoleAssignment[]     @relation("AssignmentGrantedBy")
  teamMemberships     TeamMember[]

  // Work & Domain relations
  createdTasks              Task[]                @relation("TaskCreatedBy")
  assignedTasks             Task[]                @relation("TaskAssignedTo")
  createdSubtasks           Subtask[]             @relation("SubtaskCreatedBy")
  assignedSubtasks          Subtask[]             @relation("SubtaskAssignedTo")
  reportedViolations        ComplianceViolation[] @relation("ViolationReportedBy")
  resolvedViolations        ComplianceViolation[] @relation("ViolationResolvedBy")
  stepsAssigned             ProcessInstanceStep[] @relation("StepAssignedTo")
  stepsActioned             ProcessInstanceStep[] @relation("StepActionedBy")
  escalationsReported       Escalation[]          @relation("EscalationReportedBy")
  escalationsTargeted       Escalation[]          @relation("EscalationTargetManager")
  evidenceSubmitted         ComplianceEvidence[]  @relation("EvidenceSubmittedBy")
  evidenceReviewed          ComplianceEvidence[]  @relation("EvidenceReviewedBy")
  ownedComplianceCategories ComplianceCategory[]  @relation("ComplianceCategoryOwner")
  uploadedFiles             FileObject[]          @relation("FileUploadedBy")
  notifications             Notification[]
  auditLogs                 AuditLog[]            @relation("PerformedBy")

  @@unique([id, companyId])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([managerUserId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique
  module      String
  description String
  createdAt   DateTime @default(now())

  roleTemplates RoleTemplatePermission[]
  roles         RolePermission[]

  @@map("permissions")
}

model RoleTemplate {
  id          String             @id @default(uuid())
  slug        String             @unique
  label       String
  description String?
  origin      RoleTemplateOrigin @default(platform_predefined)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  defaultPermissions RoleTemplatePermission[]
  roles              Role[]

  @@map("role_templates")
}

enum RoleTemplateOrigin {
  platform_predefined
  company_custom
}

model RoleTemplatePermission {
  roleTemplateId String
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleTemplateId, permissionId])
  @@map("role_template_permissions")
}

model Role {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleTemplateId String?
  roleTemplate   RoleTemplate? @relation(fields: [roleTemplateId], references: [id])
  name           String
  label          String
  description    String?
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  permissions     RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType     ScopeType
  scopeId       String
  grantedById   String?
  grantedByUser User?     @relation("AssignmentGrantedBy", fields: [grantedById], references: [id])
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@unique([id, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@map("role_assignments")
}

enum ScopeType {
  Company
  Branch
  Team
  Project
}

// ---------------------------------------------------------------------------
// 4. ORGANIZATIONAL HIERARCHY (Branches, Teams, Membership)
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  @@unique([id, companyId])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

model Team {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  TeamMember[]
  projects Project[]

  @@unique([id, companyId])
  @@unique([branchId, name])
  @@index([companyId])
  @@index([branchId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?  @default("Member")
  joinedAt  DateTime @default(now())

  @@unique([id, companyId])
  @@unique([teamId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// 5. WORK MANAGEMENT (Projects, Tasks, Subtasks, Escalations)
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id])
  name        String
  description String?
  status      ProjectStatus @default(Active)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks            Task[]
  processInstances ProcessInstance[]
  escalations      Escalation[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([teamId])
  @@index([companyId, status])
  @@map("projects")
}

enum ProjectStatus {
  Planning
  Active
  OnHold
  Completed
  Cancelled
}

model Task {
  id                    String       @id @default(uuid())
  companyId             String
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id])
  processInstanceStepId String?
  title                 String
  description           String?
  status                TaskStatus   @default(Draft)
  priority              TaskPriority @default(Medium)
  assignedToId          String?
  assignedTo            User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById           String
  createdBy             User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate               DateTime?
  completedAt           DateTime?
  estimatedHours        Decimal?     @db.Decimal(5, 2)
  actualHours           Decimal?     @default(0) @db.Decimal(5, 2)
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  subtasks           Subtask[]
  escalations        Escalation[]
  complianceEvidence ComplianceEvidence[]

  @@unique([id, companyId])
  @@index([companyId, status, dueDate])
  @@index([assignedToId, status])
  @@index([projectId])
  @@index([companyId, deletedAt])
  @@map("tasks")
}

enum TaskStatus {
  Draft
  Active
  In_Review
  Blocked
  Completed
  Cancelled
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

model Subtask {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       TaskStatus @default(Draft)
  assignedToId String?
  assignedTo   User?      @relation("SubtaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User       @relation("SubtaskCreatedBy", fields: [createdById], references: [id])
  dueDate      DateTime?
  completedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([id, companyId])
  @@index([companyId])
  @@index([taskId])
  @@index([assignedToId])
  @@map("subtasks")
}

model Escalation {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?            @relation(fields: [taskId], references: [id])
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id])
  reportedById    String
  reportedBy      User             @relation("EscalationReportedBy", fields: [reportedById], references: [id])
  targetManagerId String?
  targetManager   User?            @relation("EscalationTargetManager", fields: [targetManagerId], references: [id])
  title           String
  description     String?
  blockerType     String?
  priority        Severity         @default(High)
  status          EscalationStatus @default(Open)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?

  @@unique([id, companyId])
  @@index([companyId])
  @@index([taskId])
  @@index([companyId, status])
  @@map("escalations")
}

enum EscalationStatus {
  Open
  Reviewed
  Resolved
  Closed
}

// ---------------------------------------------------------------------------
// 6. PROCESS ENGINE (Versioned Templates, Steps & Instances)
// ---------------------------------------------------------------------------

model ProcessTemplate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps     ProcessTemplateStep[]
  instances ProcessInstance[]

  @@unique([id, companyId])
  @@unique([companyId, name, version])
  @@index([companyId])
  @@map("process_templates")
}

model ProcessTemplateStep {
  id                     String                @id @default(uuid())
  companyId              String
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId             String
  template               ProcessTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder              Int
  name                   String
  stepType               StepType
  requiredPermissionSlug String?
  escalationTimeoutHours Int?
  onRejectGotoStepId     String?
  onRejectGotoStep       ProcessTemplateStep?  @relation("StepLoopBack", fields: [onRejectGotoStepId], references: [id])
  loopBackTargetFor      ProcessTemplateStep[] @relation("StepLoopBack")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  instanceSteps ProcessInstanceStep[]

  @@unique([id, companyId])
  @@unique([templateId, stepOrder])
  @@index([companyId])
  @@map("process_template_steps")
}

enum StepType {
  Approval
  Input_Required
  Automated_Task
}

model ProcessInstance {
  id            String                @id @default(uuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId    String
  template      ProcessTemplate       @relation(fields: [templateId], references: [id])
  projectId     String?
  project       Project?              @relation(fields: [projectId], references: [id])
  title         String
  status        ProcessInstanceStatus @default(Draft)
  currentStepId String?
  currentStep   ProcessInstanceStep?  @relation("CurrentStep", fields: [currentStepId], references: [id])
  initiatedById String
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  steps ProcessInstanceStep[] @relation("InstanceSteps")

  @@unique([id, companyId])
  @@index([companyId])
  @@index([templateId])
  @@map("process_instances")
}

enum ProcessInstanceStatus {
  Draft
  Active
  Completed
  Cancelled
  Rejected
}

model ProcessInstanceStep {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processInstanceId String
  processInstance   ProcessInstance     @relation("InstanceSteps", fields: [processInstanceId], references: [id], onDelete: Cascade)
  templateStepId    String
  templateStep      ProcessTemplateStep @relation(fields: [templateStepId], references: [id])
  assignedToId      String?
  assignedTo        User?               @relation("StepAssignedTo", fields: [assignedToId], references: [id])
  actionedById      String?
  actionedBy        User?               @relation("StepActionedBy", fields: [actionedById], references: [id])
  status            StepStatus          @default(Pending)
  remarks           String?
  actionedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  currentForInstance ProcessInstance[] @relation("CurrentStep")

  @@unique([id, companyId])
  @@unique([processInstanceId, templateStepId])
  @@index([companyId])
  @@index([processInstanceId])
  @@map("process_instance_steps")
}

enum StepStatus {
  Pending
  Approved
  Rejected
  Skipped
}

// ---------------------------------------------------------------------------
// 7. COMPLIANCE ENGINE (Categories, Rules, Bindings, Violations, Evidence)
// ---------------------------------------------------------------------------

model ComplianceCategory {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  ownerId     String?
  owner       User?    @relation("ComplianceCategoryOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules ComplianceRule[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("compliance_categories")
}

model ComplianceRule {
  id               String              @id @default(uuid())
  companyId        String?
  company          Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  severity         Severity
  categoryId       String?
  category         ComplianceCategory? @relation(fields: [categoryId], references: [id])
  isActive         Boolean             @default(true)
  triggerEvent     String?             // e.g., 'task.completed', 'process.step.approved'
  conditionType    String?             // e.g., 'EVIDENCE_REQUIRED', 'TIME_LIMIT'
  conditionConfig  Json?               @default("{}")
  sourceTemplateId String?
  sourceTemplate   ComplianceRule?     @relation("ClonedFrom", fields: [sourceTemplateId], references: [id])
  clonedRules      ComplianceRule[]    @relation("ClonedFrom")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bindings   ComplianceBinding[]
  violations ComplianceViolation[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([categoryId])
  @@map("compliance_rules")
}

enum Severity {
  Low
  Medium
  High
  Critical
}

model ComplianceBinding {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  scopeType ScopeType
  scopeId   String
  createdAt DateTime       @default(now())

  @@unique([id, companyId])
  @@unique([companyId, ruleId, scopeType, scopeId])
  @@index([companyId])
  @@index([scopeType, scopeId])
  @@map("compliance_bindings")
}

model ComplianceViolation {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId            String
  rule              ComplianceRule  @relation(fields: [ruleId], references: [id])
  entityType        String          // 'Task', 'ProcessInstance', etc.
  entityId          String
  status            ViolationStatus @default(Open)
  severity          Severity
  detectedAt        DateTime        @default(now())
  reportedById      String?
  reportedBy        User?           @relation("ViolationReportedBy", fields: [reportedById], references: [id])
  resolvedById      String?
  resolvedBy        User?           @relation("ViolationResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?
  resolutionRemarks String?
  dueDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  evidence ComplianceEvidence[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([entityType, entityId])
  @@index([ruleId])
  @@map("compliance_violations")
}

enum ViolationStatus {
  Open
  Under_Review
  Resolved
  Ignored
}

model ComplianceEvidence {
  id            String               @id @default(uuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User                 @relation("EvidenceSubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?                @relation(fields: [taskId], references: [id])
  violationId   String?
  violation     ComplianceViolation? @relation(fields: [violationId], references: [id])
  fileObjectId  String?
  fileObject    FileObject?          @relation(fields: [fileObjectId], references: [id])
  title         String
  evidenceType  String?
  fileUrl       String
  notes         String?
  status        EvidenceStatus       @default(Pending)
  reviewedById  String?
  reviewedBy    User?                @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])
  submittedAt   DateTime             @default(now())
  reviewedAt    DateTime?
  reviewRemarks String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([id, companyId])
  @@index([companyId])
  @@index([taskId])
  @@index([violationId])
  @@index([fileObjectId])
  @@map("compliance_evidence")
}

enum EvidenceStatus {
  Pending
  Under_Review
  Approved
  Rejected
}

// ---------------------------------------------------------------------------
// 8. CROSS-CUTTING (Files, Notifications & Append-Only Audit Log)
// ---------------------------------------------------------------------------

model FileObject {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  resourceType String?   // 'Task', 'Evidence', 'Company'
  resourceId   String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  evidenceRecords ComplianceEvidence[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([uploadedById])
  @@index([resourceType, resourceId])
  @@map("file_objects")
}

model Notification {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // e.g. 'TASK_ASSIGNED', 'ESCALATION_OPENED', 'VIOLATION_DETECTED'
  title        String
  body         String
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([id, companyId])
  @@index([companyId])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId        String?
  actorType      String      @default("user") // 'user', 'platform_admin', 'system'
  impersonatorId String?
  action         AuditAction
  resourceType   String
  resourceId     String
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  occurredAt     DateTime    @default(now())

  performedBy User? @relation("PerformedBy", fields: [actorId], references: [id])

  @@index([companyId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  PERMISSION_CHANGE
  ROLE_ASSIGNED
  ROLE_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SUPPORT_ACCESS_GRANTED
  SUPPORT_ACCESS_REVOKED
  EVIDENCE_APPROVED
  EVIDENCE_REJECTED
  VIOLATION_RESOLVED
}
